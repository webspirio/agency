{
  // The file every mock's `.oxlintrc.json` extends. `jsPlugins` resolves
  // relative to THIS file, so it and `oxlint-rules.js` travel as a pair.
  //
  // Nothing here is an exemption for a specific file: exemptions belong in the
  // workspace's own `.oxlintrc.json`, which nothing extends. An exemption
  // written here would ship to every mock in the agency, present and future.
  "jsPlugins": ["./oxlint-rules.js"],

  "rules": {
    "agency/no-float-arithmetic": "error",
    "agency/no-decimal-comparison": "error",
    "agency/no-numeric-coercion": "error",
    "agency/no-unordered-id": "error",
    "agency/no-implicit-sort": "error"
  },

  "overrides": [
    {
      // The half of the presentation scoping that is a real invariant, and the
      // half that applies to the kit as much as to a mock's own screens: money
      // is computed in `src/domain` and `src/api` and reaches a component as a
      // finished decimal string. A component that needs `@agency/dec` is doing
      // arithmetic the Nest controller will have to do again at conversion.
      //
      // Anchored with `**/` deliberately: `overrides.files` resolves relative to
      // the directory of the config that APPLIES to a file, not the one that
      // declares it, so a glob written `src/pages/**` would silently change
      // meaning inside `mocks/<slug>/`, which carries its own `.oxlintrc.json`.
      "files": ["**/src/pages/**", "**/src/components/**", "**/kit/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@agency/dec",
                "message": "Money is computed in src/domain and src/api and reaches a component as a finished decimal string. A component that needs @agency/dec is doing arithmetic the Nest controller will have to do again at conversion."
              }
            ]
          }
        ]
      }
    },
    {
      // A MOCK'S OWN screens, and only those. These two rules are syntactic
      // proxies: they cannot see that `(v - lo) / span` is an SVG coordinate and
      // `index > 0` is an array position. Left firing on generated client code
      // they make an operator's first experience of the framework a red build on
      // their own chart — and SPEC 17 names "the operator disables a check row
      // rather than fixing what it caught" as the abandon signal. The `off` is
      // paid for by the `no-restricted-imports` block above, so the invariant is
      // enforced from the other side rather than dropped, and anything under
      // `src/domain/` or `src/api/` — where a mock's money actually lives —
      // keeps every rule.
      //
      // `**/kit/src/**` is deliberately NOT in this list. The kit is agency code,
      // written once and read by every mock, so it is held to the rule rather
      // than scoped out of it: its nine pixel-maths sites carry a
      // `// oxlint-disable-next-line agency/<rule>` on the offending line, and
      // `sparkline.tsx` — seven findings, all geometry — is exempted by name and
      // by count in the workspace's own `.oxlintrc.json`. A blanket glob here
      // would have gone on silently covering kit code nobody has written yet,
      // uncounted by the `lint:exempt` ratchet, which reads `.oxlintrc.json`
      // only.
      "files": ["**/src/pages/**", "**/src/components/**"],
      "rules": {
        "agency/no-float-arithmetic": "off",
        "agency/no-decimal-comparison": "off"
      }
    }
  ]
}

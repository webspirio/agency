{
  // The file every mock's `.oxlintrc.json` extends. `jsPlugins` resolves
  // relative to THIS file, so it and `oxlint-rules.js` travel as a pair.
  //
  // Nothing here is an exemption for a specific file: exemptions belong in the
  // workspace's own `.oxlintrc.json`, which nothing extends. An exemption
  // written here would ship to every mock in the agency, present and future.
  "jsPlugins": ["./oxlint-rules.js"],

  "rules": {
    "agency/no-float-arithmetic": "error",
    "agency/no-decimal-comparison": "error",
    "agency/no-numeric-coercion": "error",
    "agency/no-unordered-id": "error",
    "agency/no-implicit-sort": "error"
  },

  "overrides": [
    {
      // Presentation code, scoped rather than exempted.
      //
      // These rules are syntactic proxies: they cannot see that `(v - lo) / span`
      // is an SVG coordinate and `index > 0` is an array position. Left firing
      // repo-wide they make an operator's first experience of the framework a red
      // build on their own chart — and SPEC 17 names "the operator disables a
      // check row rather than fixing what it caught" as the abandon signal.
      //
      // The exemption is PAID FOR by the `no-restricted-imports` line below: a
      // page that cannot be caught doing money arithmetic is instead forbidden
      // from importing the money module at all. The invariant "money is computed
      // in the domain, pages render finished strings" is enforced from the other
      // side, not dropped. Anything under `src/domain/` or `src/api/` — where a
      // mock's money actually lives — keeps every rule.
      //
      // Anchored with `**/` deliberately: `overrides.files` resolves relative to
      // the directory of the config that APPLIES to a file, not the one that
      // declares it, so a glob written `src/pages/**` would silently change
      // meaning inside `mocks/<slug>/`, which carries its own `.oxlintrc.json`.
      "files": ["**/src/pages/**", "**/src/components/**", "**/kit/src/**"],
      "rules": {
        "agency/no-float-arithmetic": "off",
        "agency/no-decimal-comparison": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@agency/dec",
                "message": "Money is computed in src/domain and src/api and reaches a component as a finished decimal string. A component that needs @agency/dec is doing arithmetic the Nest controller will have to do again at conversion."
              }
            ]
          }
        ]
      }
    }
  ]
}

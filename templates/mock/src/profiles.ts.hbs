/* @scaffold-owned — generated by `agency new --profiles`. One codebase, several
   prospects; the profile decides which product this build IS.

   Read ONCE at module start, from `?profile=` then VITE_PROFILE, and NEVER
   persisted. A stored profile survives "reset demo data" — pre-call step #1 —
   and leaves the show running in the wrong client's product. */
import { createProfiles, type Actor } from '@agency/mock';

/* `agency new --profiles a,b` gives each profile exactly ONE capability, named
   after the profile. That is deliberate, not a renderer limitation to work
   around: the scaffolder cannot know a client's capability vocabulary at t=0.
   Widen a profile by hand — `caps: ['fleet', 'money']` — and every route
   tagged with either becomes reachable, with no other file to update. */
export const PROFILES = createProfiles(
  [{{#each profiles}}
    { id: '{{this.id}}', label: '{{this.label}}', caps: ['{{this.id}}'] },{{/each}}
  ] as const,
  '{{defaultProfile}}',
);

export const PROFILE = PROFILES.resolve(
  typeof window === 'undefined' ? '' : window.location.search,
  import.meta.env.VITE_PROFILE,
);

/** What `mockAdapter` gates every route on. Widened to `string` so a screen may
 *  name a capability without importing the profile union. */
export const CAPS: Set<string> = PROFILES.capsOf(PROFILE);

/** The actor every handler sees. From the session, NEVER from a request body —
 *  a handler that reads an actor off the wire is a mock that cannot become a
 *  product. */
export const ACTOR: Actor = { id: 'demo-user', role: 'owner' };
